# --- Spotify ---
# Crée une application sur https://developer.spotify.com/dashboard
# puis copie l'identifiant et le secret ici.
SPOTIFY_CLIENT_ID=ton_client_id
SPOTIFY_CLIENT_SECRET=ton_client_secret

# URI de redirection : doit être AJOUTÉE À L'IDENTIQUE dans les "Redirect URIs"
# du dashboard Spotify. Spotify n'accepte plus "localhost" -> utilise 127.0.0.1.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/callback

# --- Serveur ---
PORT=3000
